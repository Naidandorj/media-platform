# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=KEEP_THIS_SECRET_NEVER_EXPOSE_TO_BROWSER

# QPay merchant credentials (request these from QPay; do not use personal bank credentials)
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=YOUR_QPAY_USERNAME
QPAY_PASSWORD=YOUR_QPAY_PASSWORD
QPAY_INVOICE_CODE=YOUR_QPAY_INVOICE_CODE
QPAY_CALLBACK_URL=https://YOUR-VERCEL-DOMAIN.vercel.app/api/qpay/verify

# Membership price in MNT
MEMBERSHIP_PRICE_MNT=9900
SITE_URL=http://localhost:3000
